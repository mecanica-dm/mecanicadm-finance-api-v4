    {
      "source": "finance-input",
      "vhost": "/",
      "destination": "payment",
      "destination_type": "queue",
      "routing_key": "",
      "arguments": {
        "x-match": "all",
        "event-type": "GeneratePaymentIntegrationCommand"
      }
    }
  ]
